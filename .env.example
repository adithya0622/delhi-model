[TEMPLATE]
# ── Application ──────────────────────────────────────────────
APP_ENV=production
APP_DEBUG=false

# Key required on the X-API-Key header for POST /api/v1/ingest/*.
# GET endpoints are public (rate-limited). Generate something long and random:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Leaving this unset, or leaving the placeholder below in place, does not open the
# endpoint up — ingestion returns 503 until a real key is configured.
APP_API_KEY=your-secret-api-key-here

# ── CORS ─────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:8501,https://your-frontend-domain.com

# ── Rate Limiting ─────────────────────────────────────────────
# Not configurable by environment. Limits are per-endpoint (20-120 req/min) and
# are declared with @limiter.limit(...) in backend/app/api/v1/endpoints.py. An
# unused RATE_LIMIT variable used to be listed here.

# ── External Data APIs ────────────────────────────────────────
# NASA FIRMS — stubble-burning fire detections (VIIRS + MODIS NRT).
# Free MAP_KEY, issued instantly by email:
#   https://firms.modaps.eosdis.nasa.gov/api/area/
# REQUIRED for the plume feature. Without it /api/v1/plume/vectors returns an
# empty hotspot list — the code does not fabricate fires to fill the map.
FIRMS_API_KEY=your-firms-api-key-here

# OpenAQ v3 — live CPCB station readings, used by /api/v1/realtime/* and to
# anchor hour 0 of the forecast.
# An API key IS REQUIRED. v3 rejects unauthenticated requests with 401; only the
# retired v2 API was open. Free registration:
#   https://explore.openaq.org/register
OPENAQ_API_KEY=your-openaq-api-key-here

# Open-Meteo — pressure-level temperature, boundary layer height, solar
# radiation and 850 hPa winds. Free, no key, no registration.

# ── Removed keys ──────────────────────────────────────────────
# REDIS_URL and SECRET_KEY were listed here and read by nothing: there is no
# out-of-process cache and no JWT layer. If either is still present in your local
# .env it is ignored rather than fatal.

# Five-source consensus provider credentials (backend only)
OPENWEATHER_API_KEY=
API_NINJAS_API_KEY=
METEOSOURCE_API_KEY=
IQAIR_API_KEY=

# WeatherAPI — preferred 6-pollutant chemistry feed for the ML endpoint
# (/forecast/72hr-ml). Free tier, one key: https://www.weatherapi.com/signup.aspx
# Optional: when absent the endpoint falls back to Open-Meteo CAMS (keyless).
WEATHERAPI_API_KEY=

# Groq — server-side proxy for /api/v1/health/chat (AI health assistant).
# Free key: https://console.groq.com/keys. Optional: the console also accepts
# a pasted key and has an offline fallback engine.
GROQ_API_KEY=

# CPCB — reserved for a future official CPCB API integration; read by config,
# unused by any current endpoint. Leave empty.
CPCB_API_KEY=

# WRF-Chem offline reference (optional)
# Point at a directory of wrfout_* NetCDF files to enable /validation/wrf-status
# and /validation/wrf-compare (WRF-Chem vs CAMS at the Delhi point). Produce the
# files for free with scripts/wrfchem/kaggle_wrfchem_run.ipynb (Kaggle/Colab),
# then download the wrfout tarball into a local folder and set the path here.
# Unset in normal deployments; the surrogate stays the live path and IITM
# SAFAR/EWS (/validation/safar, keyless) is the operational coupled reference.
WRF_OUTPUT_DIR=
